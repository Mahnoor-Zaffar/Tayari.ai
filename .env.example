# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tayari:tayari_dev@localhost:5432/tayari

# ── Redis ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7
JWT_EMAIL_VERIFY_EXPIRY_HOURS=24
JWT_PASSWORD_RESET_EXPIRY_HOURS=1

# ── AI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTERVIEWER_MODEL=gpt-4o-mini
AI_EVALUATOR_MODEL=gpt-4o
AI_MAX_TOKENS_PER_INTERVIEW=10000
AI_COST_CAP_DOLLARS=0.30

# ── Deepgram ────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINTING=300

# ── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend ──────────────────────────────────────────────────────────────
RESEND_API_KEY=

# ── Sentry ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Object Storage (S3-compatible: MinIO, S3, R2) ───────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tayari-evaluations
STORAGE_REGION=us-east-1

# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Admin ───────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@tayari.ai

# ── App ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
INTERVIEW_DURATION_MINUTES=30
GRACE_PERIOD_MINUTES=10
ENVIRONMENT=development

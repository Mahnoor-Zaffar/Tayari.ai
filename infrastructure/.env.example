# ── Domains ────────────────────────────────────────────────────────────────
DOMAIN=tayari.ai
API_DOMAIN=api.tayari.ai
FRONTEND_URL=https://tayari.ai
PUBLIC_API_URL=https://api.tayari.ai
# list[str] — pydantic-settings parses JSON for list fields (comma-separated will error)
CORS_ORIGINS=["https://tayari.ai","https://www.tayari.ai"]
NEXT_PUBLIC_API_URL=https://api.tayari.ai

# ── Database ──────────────────────────────────────────────────────────────
POSTGRES_USER=tayari
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=tayari
# DATABASE_URL is derived from the above inside compose (host = "db" on the VM)

# ── App / Auth ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ADMIN_EMAILS=admin@tayari.ai

# ── External providers (leave blank to disable) ───────────────────────────
OPENAI_API_KEY=
RESEND_API_KEY=
DEEPGRAM_API_KEY=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tayari-evaluations
STORAGE_REGION=us-east-1

# ── Web build args (flags must be 1 or 0 at build time) ───────────────────
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_FF_INTERVIEWS=1
NEXT_PUBLIC_FF_REPORTS=1
NEXT_PUBLIC_FF_SETTINGS=1
NEXT_PUBLIC_FF_NEW_INTERVIEW=1
NEXT_PUBLIC_FF_ANALYTICS=1
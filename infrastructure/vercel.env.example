# Vercel (Hobby) environment variables — paste these into
# Vercel → Project → Settings → Environment Variables (Production).
# Replace YOURDOMAIN everywhere. Values marked (leave blank) keep that feature off.

# ── API / WebSockets (one var drives both REST + wss:// paths) ─────────────
NEXT_PUBLIC_API_URL=https://api.YOURDOMAIN.com/api/v1
NEXT_PUBLIC_SITE_URL=https://YOURDOMAIN.com

# ── Supabase (social login only — leave blank to disable; email/password auth works without it) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Sentry ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── Feature flags (1 = on, 0 = off) ────────────────────────────────────────
NEXT_PUBLIC_FF_INTERVIEWS=1
NEXT_PUBLIC_FF_REPORTS=1
NEXT_PUBLIC_FF_SETTINGS=1
NEXT_PUBLIC_FF_NEW_INTERVIEW=1
NEXT_PUBLIC_FF_ANALYTICS=1

# ── Misc ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION=0.1.0
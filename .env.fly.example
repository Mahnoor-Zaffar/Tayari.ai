# Environment template for the Tayari AI production deployment (Fly.io).
#
# Public/non-secret values live in apps/api/fly.toml and fly.toml ([env] and
# [build.args]). Everything below MUST be set as secrets via:
#
#   fly secrets set KEY=value    # (run inside the api service directory)
#
# The web app has no secrets of its own — NEXT_PUBLIC_* are public build args.

# ── API secrets (set on the `tayari-api` app) ────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY=

# Fly Postgres connection string. Post-Boomer scheme is `postgres://...`; the
# app needs asyncpg. After `fly postgres attach tayari-pg`, re-set it as:
#   postgresql+asyncpg://<user>:<password>@tayari-pg.internal:5432/<db>
DATABASE_URL=postgresql+asyncpg://tayari:tayari_dev@localhost:5432/tayari

OPENAI_API_KEY=
RESEND_API_KEY=            # outbound verification/reset emails
DEEPGRAM_API_KEY=          # speech-to-text

# Optional
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_URL=              # social login (Google/GitHub)
SUPABASE_SERVICE_KEY=
STORAGE_ENDPOINT=          # S3-compatible object storage for evaluations
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tayari-evaluations
STORAGE_REGION=us-east-1

# Comma-separated admin email addresses. Admin is only granted AFTER the
# address is verified — remove the default test address in production.
ADMIN_EMAILS=admin@tayari.ai

# ── Fly Postgres (one-time) ──────────────────────────────────────────────────
# fly postgres create --name tayari-pg --region <region>
# fly postgres attach tayari-pg           (sets a DATABASE_URL secret)
# Fix the scheme, then force the corrected value:
# fly secrets set "DATABASE_URL=postgresql+asyncpg://$(...)"
#   (copy user/pass/db from `fly ssh console -C 'printenv DATABASE_URL'`)
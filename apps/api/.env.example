# Tayari AI — API environment variables (EXAMPLE / PLACEHOLDERS ONLY)
#
# Copy to `apps/api/.env` and fill in real values locally.  This file is
# committed with placeholders only — never put real secrets here.
# `apps/api/.env` is gitignored.

# ── Environment ──────────────────────────────────────────────────────────
# development | test | production
ENVIRONMENT=development

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://tayari:tayari_dev@localhost:5432/tayari

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ──────────────────────────────────────────────────────────────────
# Use a strong random value (>= 32 chars) in production.
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=7
JWT_EMAIL_VERIFY_EXPIRY_HOURS=24
JWT_PASSWORD_RESET_EXPIRY_HOURS=1

# ── AI (OpenAI / OpenRouter compatible) ─────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTERVIEWER_MODEL=gpt-4o-mini
AI_EVALUATOR_MODEL=gpt-4o
AI_MAX_TOKENS_PER_INTERVIEW=10000
AI_COST_CAP_DOLLARS=0.30

# ── Deepgram (voice) ─────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_ENDPOINTING=300

# ── Stripe (billing) ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Resend (transactional email) ─────────────────────────────────────────
RESEND_API_KEY=

# ── Sentry (error monitoring / alerting) ─────────────────────────────────
SENTRY_DSN=

# ── Object Storage (S3-compatible: MinIO, S3, R2) ────────────────────────
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=tayari-evaluations
STORAGE_REGION=us-east-1

# ── Supabase (optional) ──────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Admin ────────────────────────────────────────────────────────────────
ADMIN_EMAILS=admin@tayari.ai

# ── App ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
# Public base URL of this API as browsers see it (used for CSP connect-src).
# In production set to e.g. https://api.tayari.ai
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
INTERVIEW_DURATION_MINUTES=30
GRACE_PERIOD_MINUTES=10
